{
  "$comment": "The one source for colour, type and spacing. scripts/build-tokens.ts renders a CSS file per surface from this; those files are never hand-edited and tests/design.test.ts fails when one is stale. Direction: light, technical, diagram-led.",
  "color": {
    "bg":        { "value": "#FFFFFF", "role": "surface", "use": "page background" },
    "bg-alt":    { "value": "#F6F6F4", "role": "surface", "use": "alternating section band" },
    "bg-inset":  { "value": "#EDEDE8", "role": "surface", "use": "table headers, inset panels" },
    "ink":       { "value": "#16161A", "role": "text",    "use": "body and heading text" },
    "ink-muted": { "value": "#55555E", "role": "text",    "use": "secondary text, captions" },
    "line":      { "value": "#E0E0DA", "role": "border",  "use": "hairline borders and rules" },
    "accent":    { "value": "#D8431A", "role": "text",    "use": "brand mark, large headings, diagram strokes" },
    "pass":      { "value": "#11704A", "role": "state",   "use": "a check that passed" },
    "fail":      { "value": "#B5261B", "role": "state",   "use": "a check that failed" },
    "wait":      { "value": "#7A5C00", "role": "state",   "use": "waiting on a person" },
    "refuse":    { "value": "#4F41B8", "role": "state",   "use": "refused by policy, which is a success" },
    "term-bg":   { "value": "#16161A", "role": "surface", "use": "terminal blocks and the run report only" },
    "term-ink":  { "value": "#EDEDE8", "role": "text",    "use": "text inside a terminal block" }
  },
  "contrast": {
    "$comment": "Every pair a surface actually renders, with the level it must reach. The test computes the ratio rather than trusting the note beside the colour. A text or state colour absent from this list is one whose legibility nobody checked; a border is exempt through its role.",
    "pairs": [
      { "fg": "ink", "bg": "bg", "level": "AAA" },
      { "fg": "ink", "bg": "bg-alt", "level": "AAA" },
      { "fg": "ink", "bg": "bg-inset", "level": "AAA" },
      { "fg": "ink-muted", "bg": "bg", "level": "AA" },
      { "fg": "ink-muted", "bg": "bg-alt", "level": "AA" },
      { "fg": "pass", "bg": "bg", "level": "AA" },
      { "fg": "fail", "bg": "bg", "level": "AA" },
      { "fg": "wait", "bg": "bg", "level": "AA" },
      { "fg": "refuse", "bg": "bg", "level": "AA" },
      { "fg": "accent", "bg": "bg", "level": "AA-large" },
      { "fg": "term-ink", "bg": "term-bg", "level": "AAA" }
    ]
  },
  "font": {
    "sans": { "value": "system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif", "use": "everything that is not code" },
    "mono": { "value": "ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace", "use": "commands, verdicts, file paths, identifiers" }
  },
  "size": {
    "step--1": "0.8125rem",
    "step-0": "1rem",
    "step-1": "1.25rem",
    "step-2": "1.625rem",
    "step-3": "2.25rem",
    "step-4": "3rem",
    "step-5": "4rem"
  },
  "space": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "6": "1.5rem",
    "8": "2rem",
    "12": "3rem",
    "16": "4rem",
    "24": "6rem"
  },
  "radius": { "sm": "3px", "md": "6px", "lg": "10px" },
  "surfaces": [
    { "name": "teach", "out": "teach/tokens.css" },
    { "name": "console", "out": "target/apps/console/app/tokens.css" }
  ]
}
