#!/usr/bin/env bun
// The `factory` CLI: watch, dashboard, scan, reset, doctor, install.
// Thin dispatcher; all logic lives in src/ so it stays testable without a
// child process.

import { resolve } from "node:path";
import { GitHub } from "../src/github";
import { GitCommandRunner, Git } from "../src/git";
import { FactoryState, DEFAULT_DB_PATH } from "../src/state";
import { ClaudeExecutor } from "../src/executor";
import { loadConfig } from "../src/config";
import { pollOnce, startWatch, type WatchDeps } from "../src/watch";
import { scan } from "../src/scan";
import { reset } from "../src/reset";
import { runDoctor, fixDoctor } from "../src/doctor";
import { createDashboard } from "../dashboard/server";

const args = process.argv.slice(2);
const command = args[0];

function flag(name: string): string | undefined {
  const i = args.indexOf(`--${name}`);
  if (i === -1) return undefined;
  return args[i + 1];
}

function has(name: string): boolean {
  return args.includes(`--${name}`);
}

async function which(bin: string): Promise<boolean> {
  const proc = Bun.spawn(["which", bin], { stdout: "pipe", stderr: "pipe" });
  return (await proc.exited) === 0;
}

async function fileExists(path: string): Promise<boolean> {
  return await Bun.file(path).exists();
}

function requireRepoDir(): string {
  const repo = flag("repo-dir") ?? flag("repo");
  if (!repo) {
    console.error("factory: --repo-dir <path-to-clone> is required");
    process.exit(1);
  }
  return resolve(repo);
}

async function cmdWatch(): Promise<void> {
  const cloneDir = requireRepoDir();
  const config = await loadConfig(cloneDir);
  const deps: WatchDeps = {
    github: new GitHub(),
    git: new Git(new GitCommandRunner()),
    state: new FactoryState(flag("db") ?? DEFAULT_DB_PATH),
    executor: new ClaudeExecutor(),
    cloneDir,
    workspacesDir: flag("workspaces") ?? "workspaces",
  };
  console.log(`factory watch: polling ${config.repo} every ${config.pollIntervalSeconds}s`);
  if (has("once")) {
    const result = await pollOnce(deps, config);
    console.log(JSON.stringify(result, null, 2));
    return;
  }
  startWatch(deps, config, (r) => {
    if (r.paused) console.log(`factory watch: paused — ${r.reason}`);
    else if (r.processed.length) console.log(`factory watch: processed #${r.processed.join(", #")}`);
  });
  console.log("factory watch: running. Ctrl+C to stop.");
  await new Promise(() => {}); // keep the process alive
}

async function cmdScan(): Promise<void> {
  const cloneDir = requireRepoDir();
  const config = await loadConfig(cloneDir);
  // scan shells out to `bun audit`/`bun outdated`, not `git`.
  const bunRunner = {
    run: async (a: string[], opts?: { cwd?: string }) => {
      const proc = Bun.spawn(["bun", ...a], { cwd: opts?.cwd, stdout: "pipe", stderr: "pipe" });
      const [stdout, stderr, code] = await Promise.all([
        new Response(proc.stdout).text(),
        new Response(proc.stderr).text(),
        proc.exited,
      ]);
      return { stdout, stderr, code };
    },
  };
  const result = await scan({ github: new GitHub(), runner: bunRunner }, config.repo, cloneDir);
  console.log(`factory scan: filed ${result.filed.length}, skipped ${result.skipped.length} (already open)`);
  for (const t of result.filed) console.log(`  + ${t}`);
}

async function cmdReset(): Promise<void> {
  const cloneDir = requireRepoDir();
  const config = await loadConfig(cloneDir);
  const dryRun = has("dry-run");
  const ctx = {
    repo: config.repo,
    cloneDir,
    baselineTag: config.baselineTag,
    issuesDir: `${cloneDir}/.factory/issues`,
    workspacesDir: flag("workspaces") ?? "workspaces",
    statePath: flag("db") ?? DEFAULT_DB_PATH,
  };
  const deps = { github: new GitHub(), git: new GitCommandRunner() };
  const summary = await reset(deps, ctx, dryRun);
  console.log(`factory reset${dryRun ? " --dry-run" : ""}: ${summary.actions.length} action(s)`);
  for (const a of summary.actions) console.log(`  ${dryRun ? "would " : ""}${a.kind}: ${a.detail}`);
}

async function cmdDoctor(): Promise<void> {
  const cloneDir = requireRepoDir();
  const config = await loadConfig(cloneDir);
  const github = new GitHub();
  const checks = await runDoctor(
    { github, git: new GitCommandRunner(), which, fileExists },
    { repo: config.repo, cloneDir, baselineTag: config.baselineTag },
  );
  let allOk = true;
  for (const c of checks) {
    console.log(`  [${c.ok ? "ok" : "FAIL"}] ${c.name} — ${c.detail}`);
    if (!c.ok) allOk = false;
  }
  if (!allOk && has("fix")) {
    console.log("factory doctor --fix: creating missing labels");
    await fixDoctor(github, config.repo);
  }
  if (!allOk && !has("fix")) process.exit(1);
}

async function cmdDashboard(): Promise<void> {
  // `dashboard/server.ts`'s own `if (import.meta.main)` block never fires
  // here: this file is the process entry point, so that module is always
  // imported, not run directly. Call createDashboard + Bun.serve ourselves.
  const port = Number(flag("port") ?? process.env.FACTORY_DASHBOARD_PORT ?? 4100);
  const dbPath = flag("db") ?? process.env.FACTORY_DB_PATH ?? DEFAULT_DB_PATH;
  const repo = flag("repo") ?? process.env.FACTORY_REPO ?? "";
  const state = new FactoryState(dbPath);
  const github = new GitHub();
  const dashboard = createDashboard(state, github, repo);
  Bun.serve({ port, fetch: (req) => dashboard.handle(req) });
  console.log(`factory dashboard: http://localhost:${port} (repo=${repo || "unset"})`);
  await new Promise(() => {}); // keep the process alive
}

async function cmdInstall(): Promise<void> {
  const target = args[1];
  if (!target) {
    console.error("factory install: usage: factory install <target-dir> [--dry-run]");
    process.exit(1);
  }
  const dryRunArg = has("dry-run") ? ["--dry-run"] : [];
  const script = resolve(import.meta.dir, "..", "install.sh");
  const proc = Bun.spawn(["bash", script, target, ...dryRunArg], { stdout: "inherit", stderr: "inherit" });
  const code = await proc.exited;
  if (code !== 0) process.exit(code);
}

async function main(): Promise<void> {
  switch (command) {
    case "watch":
      return cmdWatch();
    case "dashboard":
      return cmdDashboard();
    case "scan":
      return cmdScan();
    case "reset":
      return cmdReset();
    case "doctor":
      return cmdDoctor();
    case "install":
      return cmdInstall();
    default:
      console.log(
        [
          "factory <command>",
          "",
          "  watch [--repo-dir <path>] [--once]   poll and drive the loop",
          "  dashboard                            serve the board on :4100",
          "  scan --repo-dir <path>                file issues from bun audit/outdated",
          "  reset --repo-dir <path> [--dry-run]   put the target back to baseline",
          "  doctor --repo-dir <path> [--fix]      check the loop can run",
          "  install <target-dir> [--dry-run]      install the template",
        ].join("\n"),
      );
      if (command && command !== "help" && command !== "--help") process.exit(1);
  }
}

await main();
