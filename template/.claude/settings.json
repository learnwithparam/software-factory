{
  "permissions": {
    "deny": [
      "Bash(gh *)",
      "Bash(git push*)",
      "Bash(git merge *)",
      "Bash(git reset --hard *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Read(~/.config/gh/**)",
      "Read(~/.ssh/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/guard-paths.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
